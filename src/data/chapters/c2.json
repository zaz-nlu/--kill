  "endings": {
    "true": {
      "title": "案二·静音 · 真相",
      "text": "陆诚签了字。\n定时任务、改过的代码、被撕碎的外卖单，一条一条指向同一只手。苏闻没有等到周五下午三点。\n那封不点名的信，老韩收在了抽屉最底下。\n雨停了。机房里的风扇，一直在转。",
      "clears": true
    },
    "bad2": {
      "title": "BAD END · 证据不足",
      "text": "你手里的东西不够。陆诚在讯问室里一句一句地推了回去，最后只说了一句：“你们拿不出证据。”\n他被放了出来。机房里的风扇，还在转。",
      "clears": false
    }
  },
  "mechanics": {
    "danger": false,
    "shop": true,
    "gifts": true
  },
  "recap": [
    {
      "title": "九月十四日，雨夜",
      "text": "贝塔 17 层，人事经理宋砚死在办公室。灯灭的那一刻，所有人都有不在场的理由，除了你。",
      "image": "hr_office"
    },
    {
      "title": "灯亮之后",
      "text": "凶手是外包后端黎默。他说是为了周屿，其实是为了钱。他带走了那座“贝塔之星”，却从没打开过它的底座。",
      "image": "meeting_a"
    },
    {
      "title": "五年前",
      "text": "周屿，某通派驻贝塔的测试。2021 年 11 月 4 日凌晨，她死在东楼梯 16 到 17 层之间的平台。贝塔把她的考勤改成了“私自返回”，家属只拿到三万元。",
      "image": "stairwell"
    },
    {
      "title": "之后",
      "text": "贺川被行政处罚，没有起诉。郑岑停职、接受内部调查，十月中复职。苏闻因评测造假留职察看、降权。孟遥自首，未被追究。熄灯令废除，贝塔限期整顿，11 月 16 日恢复营业。",
      "image": "office"
    },
    {
      "title": "林一程",
      "text": "你仍然是贝塔的程序员，不是警察。老韩从怀疑你，变成愿意听你说两句；小许跑腿，也信你。",
      "image": "police"
    },
    {
      "title": "十一月十九日，周四",
      "text": "清晨 8 点 10 分，物业撬开了机房的门。",
      "image": "server_room"
    }
  ]
}