  "notebook": {
    "entries": [
      {
        "id": "n01",
        "day": 1,
        "any": [
          "2E03"
        ],
        "text": "死因：二氧化碳窒息。不是中毒，不是外伤。",
        "place": "office"
      },
      {
        "id": "n02",
        "day": 1,
        "any": [
          "2E26"
        ],
        "text": "三只气瓶都喷空了，控制盘旋钮停在“自动”。不是漏，是整套放了一遍。",
        "place": "office"
      },
      {
        "id": "n03",
        "day": 1,
        "any": [
          "2E01"
        ],
        "text": "门禁：19:35 之后再没人进过机房。门是双层隔音门，一关，里外都听不见。",
        "place": "office"
      },
      {
        "id": "n04",
        "day": 1,
        "any": [
          "2E18"
        ],
        "text": "C4 录像：19:20 邵晓阳端两杯咖啡进来，19:35 拿自己那杯出去，之后房里只有苏闻。杯子是什么时候倒的，看不出。",
        "place": "office"
      },
      {
        "id": "n05",
        "day": 1,
        "any": [
          "2E33"
        ],
        "text": "杯套印着“巷口咖啡”，杯身手写“苏姐”。杯子是外面买的——谁买的？",
        "place": "street"
      },
      {
        "id": "n06",
        "day": 1,
        "any": [
          "2E04"
        ],
        "text": "主库被改成只读：11 月 18 日 15:10，公共账号 wb_ext，测试终端 PC-OS-03。公共账号，指不到人。",
        "place": "office"
      },
      {
        "id": "n07",
        "day": 1,
        "any": [
          "2E36"
        ],
        "text": "警示灯的灯罩被胶带贴着，苏闻自己贴的，十月底报过修。",
        "place": "office"
      },
      {
        "id": "n08",
        "day": 1,
        "any": [
          "2T06"
        ],
        "text": "老王说他昨晚一直在楼下，什么都没听见。",
        "place": "office"
      },
      {
        "id": "n09",
        "day": 2,
        "any": [
          "2E05"
        ],
        "text": "联动任务 TASK-1118-1736：17:36 创建，22:12 执行。有人提前把它排好了。",
        "place": "office"
      },
      {
        "id": "n10",
        "day": 2,
        "any": [
          "2E06"
        ],
        "text": "联动广播被屏蔽成只在机房里响。喷放的时候，门外的人听不到。",
        "place": "office"
      },
      {
        "id": "n11",
        "day": 2,
        "any": [
          "2E19"
        ],
        "text": "考勤和会议签到拿到了。昨晚几个时间点，谁在哪里，可以对。",
        "place": "office"
      },
      {
        "id": "n12",
        "day": 2,
        "any": [
          "2E08a",
          "2E08b"
        ],
        "text": "咖啡不是邵一个人经手的：前台有两杯，便利店监控里还有一个背影。",
        "place": "street"
      },
      {
        "id": "n13",
        "day": 2,
        "any": [
          "2E29",
          "2T11",
          "2T25"
        ],
        "text": "巷口咖啡的小票和杯名，店员的话，要和那只杯子对上。",
        "place": "street"
      },
      {
        "id": "n14",
        "day": 2,
        "any": [
          "2E08d",
          "2E08e"
        ],
        "text": "撕碎的外卖单拼起来了；跑腿平台上，是一张匿名下单的订单。",
        "place": "street"
      },
      {
        "id": "n15",
        "day": 2,
        "any": [
          "2E08c",
          "2T02"
        ],
        "text": "老门口饭馆：付款和离席的时间，是十八号那顿饭的证据。",
        "place": "diner"
      },
      {
        "id": "n16",
        "day": 3,
        "any": [
          "2E37"
        ],
        "text": "调度模块原版代码：窗口调度，是仓库里那一份。",
        "place": "office"
      },
      {
        "id": "n17",
        "day": 3,
        "any": [
          "2E38"
        ],
        "text": "线上跑的 jar，反编译出来和仓库代码不一样。有人改过，没提交。",
        "place": "office"
      },
      {
        "id": "n18",
        "day": 3,
        "any": [
          "2E39"
        ],
        "text": "四份没署名的写法样本，要和那份补丁对风格。",
        "place": "office"
      },
      {
        "id": "n19",
        "day": 3,
        "any": [
          "2E40"
        ],
        "text": "构建与发布记录：11 月 17 日 23:48，wb_ext 登录后换过这个 jar。",
        "place": "office"
      }
    ],
    "plans": [
      {
        "day": 1,
        "title": "第一夜 · 明天",
        "lines": [
          {
            "text": "“自动”和“只读”，都是人做的。光知道是什么没用，得知道是谁、什么时候做到的。"
          },
          {
            "needs": [
              "2E04"
            ],
            "text": "改只读的是公共账号，外包区谁都能登。明天让小许调出联动任务和日志，再看一看谁昨天能碰到那台测试终端。",
            "place": "office"
          },
          {
            "needs": [
              "2E33"
            ],
            "text": "杯子是外面买的，杯套上是“巷口咖啡”。明天去那条街，把店、监控、垃圾桶都看一遍。",
            "place": "street"
          },
          {
            "needs": [
              "2E01",
              "2E18"
            ],
            "text": "19:35 以后没人进门，可她是 22 点以后出的事。“进没进过门”不是关键，“谁能让它自己发生”才是。",
            "place": "office"
          },
          {
            "text": "先回公司，听老韩和小许手里有什么新东西。",
            "place": "office"
          }
        ]
      },
      {
        "day": 2,
        "title": "第二夜 · 明天",
        "lines": [
          {
            "needs": [
              "2E05"
            ],
            "text": "任务是 17:36 排好、22:12 才执行的。这种定时任务是人写出来的。明天把线上跑的代码拿回来看，它会留下写的人的习惯。",
            "place": "office"
          },
          {
            "needs": [
              "2E06"
            ],
            "text": "广播被屏蔽，说明有人懂这套联动怎么改。懂的人不多。",
            "place": "office"
          },
          {
            "needs": [
              "2E08e",
              "2E29"
            ],
            "text": "咖啡是匿名下的单，签收的人和付钱的人不一定是一个人。明天别忘了把平台和小票对一遍。"
          },
          {
            "needs": [
              "2E19",
              "2E08c"
            ],
            "text": "把考勤、会议签到和十八号的饭局放在一张时间表上，看谁有机会。",
            "place": "office"
          },
          {
            "text": "线上 jar 对仓库，再翻共享盘里各人的写法。东西齐了，下午去分局。",
            "place": "office"
          }
        ]
      }
    ]
  },
