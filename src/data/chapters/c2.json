  "nudges": [
    { "day": 1, "place": "office", "text": "林一程在本子上记下：老韩的人还在公司，先回那边。" },
    { "day": 2, "place": "office", "minHour": 20, "text": "本子上写着：晚上，老韩他们在公司等着对线索。" },
